{
  "manifest_version": 3,
  "name": "RentSmart",
  "short_name": "RentSmart",
  "version": "0.1.0",
  "description": "Know before you commit. Costul real al unei chirii, înainte să semnezi.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://www.cursbnr.ro/*"],
  "optional_host_permissions": ["https://*.olx.ro/*", "https://*.storia.ro/*", "https://*.imobiliare.ro/*", "https://*.publi24.ro/*", "https://*.homezz.ro/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "RentSmart: analizează anunțul",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
