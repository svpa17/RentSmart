# RĂSCRUCE AI — variabilele backend-ului. Valorile reale stau DOAR în setările Vercel
# (sau în api/.env pentru rularea locală; fișierul .env este ignorat de Git).

# Furnizorul: anthropic (implicit) sau openai (orice API compatibil Chat Completions).
AI_PROVIDER=openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_EFFORT=
AI_MAX_OUTPUT_TOKENS=4000
# Doar pentru AI_PROVIDER=openai, ex. https://api.openai.com/v1

# Origini permise (CORS e doar un filtru pentru browsere, nu autentificare).
ALLOWED_ORIGINS=chrome-extension://<ID_EXTENSIE>,http://localhost:5174
MAX_INPUT_CHARS=15000
AI_TIMEOUT_MS=20000

# Rate limiting persistent (obligatoriu în producție).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE_IP=10
RATE_LIMIT_PER_DAY_INSTALL=60
GLOBAL_DAILY_REQUEST_CAP=1000
